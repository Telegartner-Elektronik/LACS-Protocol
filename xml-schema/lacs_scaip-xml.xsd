<?xml version="1.0" encoding="UTF-8" ?>
<!--
    LACS - application/scaip+xml (mrq and mrs).
    XML Schema 1.1, no target namespace (LACS messages carry no XML namespace).
    The schema checks the syntax only. Valid code values are listed in LACS-scaip-xml.md.
    Unknown elements are accepted, as receivers must ignore them (TS 50134-9 §7.2.2).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
           vc:minVersion="1.1">

    <xs:include schemaLocation="lacs_common.xsd"/>

    <xs:element name="mrq">
        <xs:annotation><xs:documentation>message-request</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="ref" type="refType"/>
                <xs:element name="pve" type="pveType" minOccurs="0">
                    <xs:annotation><xs:documentation>protocol-version (LACS); ver of TS 50134-9 is not used and ignored</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="mreq" type="mediaType" minOccurs="0"/>
                <xs:element name="mty" type="code2Type" minOccurs="0"/>
                <xs:element name="cid" type="cidType"/>
                <xs:element name="dty" type="code4Type"/>
                <xs:element name="did" type="didType" minOccurs="0"/>
                <xs:element name="iba" type="ibaType" minOccurs="0"/>
                <xs:element name="dco" type="code3Type" minOccurs="0"/>
                <xs:element name="stc" type="code4Type" minOccurs="0"/>
                <xs:element name="lco" type="code3Type" minOccurs="0"/>
                <xs:element name="lge" minOccurs="0">
                    <xs:annotation><xs:documentation>location-geo (TS 50134-9)</xs:documentation></xs:annotation>
                    <xs:complexType mixed="true">
                        <xs:all>
                            <xs:element name="geo" minOccurs="0">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:pattern value="[0-9.,]{1,23}"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="tim" minOccurs="0">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:pattern value="[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9][+-](0[0-9]|1[0-4])"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:all>
                    </xs:complexType>
                </xs:element>
                <xs:element name="etm" type="etmType" minOccurs="0">
                    <xs:annotation><xs:documentation>event-time (LACS)</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="stt" type="text32Type" minOccurs="0">
                    <xs:annotation><xs:documentation>status-text (TS 50134-9)</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="ico" type="code3Type" minOccurs="0"/>
                <xs:element name="ite" type="text128Type" minOccurs="0"/>
                <xs:element name="asid" type="asidType"/>
                <xs:element name="cap" minOccurs="0">
                    <xs:annotation><xs:documentation>capabilities (LACS)</xs:documentation></xs:annotation>
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="[0-9]{4}(,[0-9]{4})*"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:element>
                <!-- nameplate of controller (npc...) and local unit (npl...) (LACS) -->
                <xs:element name="npcmf" type="text32Type" minOccurs="0"/>
                <xs:element name="npcty" type="text32Type" minOccurs="0"/>
                <xs:element name="npcfw" type="text32AsciiType" minOccurs="0"/>
                <xs:element name="npchi" type="hwidType" minOccurs="0"/>
                <xs:element name="npcms" type="msisdnType" minOccurs="0"/>
                <xs:element name="nplmf" type="text32Type" minOccurs="0"/>
                <xs:element name="nplty" type="text32Type" minOccurs="0"/>
                <xs:element name="nplfw" type="text32AsciiType" minOccurs="0"/>
                <xs:any processContents="lax" notQName="##defined ##definedSibling" minOccurs="0" maxOccurs="unbounded"/>
            </xs:all>
            <!-- conditional elements, see LACS-scaip-xml.md; mty defaults to ME (TS 50134-9) -->
            <xs:assert test="mty = 'RE' or exists(stc)"/>
            <xs:assert test="not(stc = ('0010', '0202', '0211', '0212')) or exists(mreq)"/>
            <xs:assert test="stc = ('0010', '0202', '0211', '0212') or not(exists(mreq))"/>
            <xs:assert test="not(stc = ('0010', '0201', '0211', '0212', '0102', '0204', '0205', '0208', '0209')) or exists(did)"/>
            <xs:assert test="not(stc = ('0204', '0205', '0208', '0209')) or exists(dco)"/>
            <xs:assert test="not(exists(iba)) or exists(did)"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="mrs">
        <xs:annotation><xs:documentation>message-response</xs:documentation></xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="ref" type="refType"/>
                <xs:element name="snu" type="numberType"/>
                <xs:element name="ste" type="asciiText128Type" minOccurs="0"/>
                <xs:element name="pve" type="pveType" minOccurs="0">
                    <xs:annotation><xs:documentation>protocol-version (LACS); cve of TS 50134-9 is not used and ignored</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="mre" type="mediaType" minOccurs="0"/>
                <xs:element name="cre" type="creType" minOccurs="0"/>
                <xs:element name="tnu" type="text256Type" minOccurs="0"/>
                <xs:element name="asid" type="asidType"/>
                <xs:any processContents="lax" notQName="##defined ##definedSibling" minOccurs="0" maxOccurs="unbounded"/>
            </xs:all>
            <!-- mre, cre and tnu occur together, see LACS-scaip-xml.md -->
            <xs:assert test="exists(cre) = exists(mre) and exists(cre) = exists(tnu)"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
